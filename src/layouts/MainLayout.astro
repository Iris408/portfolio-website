---
import "../styles/global.css";

const {
  title = "Ashleigh Magloire | Full-Stack & DevOps Engineer",
  description =
    "Software engineering portfolio of Ashleigh Magloire, focused on Python, FastAPI, React, TypeScript, APIs, Docker, CI/CD and reliable full-stack applications.",
  image = "/images/portfolio-workspace-hero.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />

      <title>{title}</title>
      <meta name="description" content={description} />
      <meta name="robots" content="index, follow" />
      <meta name="theme-color" content="#f7f6f1" />

      <link rel="canonical" href={canonicalURL} />

      <meta property="og:type" content="website" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonicalURL} />
      <meta property="og:image" content={socialImage} />
      <meta property="og:site_name" content="Ashleigh Magloire" />

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={socialImage} />

      <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      <link rel="icon" href="/favicon.ico" sizes="any" />

      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

      <link
        href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Manrope:wght@400;500;600;700&family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
        rel="stylesheet"
      />
    </head>

  <body class="min-h-screen bg-[#F7F6F1] text-[#1E2823] antialiased">
    <slot />
  </body>
</html>