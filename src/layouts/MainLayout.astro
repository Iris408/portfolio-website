---
import "../styles/global.css";

const {
  title = "Ashleigh M | Full-Stack Software Engineer",
  description = "Portfolio of Ashleigh M, a backend-focused full-stack developer building reliable web applications, APIs and digital products.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f1" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Manrope:wght@400;500;600;700&family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen bg-[#F7F6F1] text-[#1E2823] antialiased">
    <slot />
  </body>
</html>