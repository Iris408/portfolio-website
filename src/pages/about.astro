---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
---

<MainLayout
  title="About | Ashleigh Magloire"
  description="Learn about Ashleigh Magloire, a backend-focused full-stack developer building reliable, accessible and production-style web applications."
>
  <Navbar client:load />

  <main class="min-h-screen bg-[var(--portfolio-bg)] text-[var(--portfolio-ink)]">
    <!-- Hero -->
    <section class="border-b border-[var(--portfolio-line)] px-6 pb-20 pt-12 md:px-10 md:pb-20 md:pt-14">
      <div class="grid w-full gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-5 text-xs font-medium uppercase tracking-[0.3em] text-[var(--portfolio-accent)]">
            About
          </p>

          <h1 class="max-w-5xl font-serif text-4xl leading-tight md:text-6xl">
            Systems thinking, practical engineering and a people-first
            perspective.
          </h1>
        </div>

        <div class="border-l border-[#AEB9AD] pl-6 md:pl-8">
          <p class="text-base leading-8 text-[var(--portfolio-muted)] md:text-lg">
            I&apos;m Ashleigh Magloire, a backend-focused full-stack developer building
            reliable web applications, APIs and accessible digital products.
          </p>

          <p class="mt-5 text-sm leading-7 text-[var(--portfolio-muted)]">
            My work combines software engineering with experience in
            automotive technology, operational systems and customer-facing
            environments.
          </p>
        </div>
      </div>
    </section>

    <!-- Background -->
    <section class="px-6 py-20 md:px-10 md:py-24">
      <div class="grid w-full gap-14 lg:grid-cols-[0.75fr_1.25fr]">
        <aside>
          <p class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
            Background
          </p>

          <div class="mt-6 border-t border-[var(--portfolio-line)]">
            <div class="border-b border-[var(--portfolio-line)] py-5">
              <p class="text-xs uppercase tracking-[0.18em] text-[--portfolio-muted-soft]">
                Education
              </p>

              <p class="mt-2 font-serif text-lg text-[var(--portfolio-ink)]">
                MSc Computer Science
              </p>

              <p class="mt-1 text-sm text-[var(--portfolio-muted)]">
                Heriot-Watt University · In progress
              </p>
            </div>

            <div class="border-b border-[var(--portfolio-line)] py-5">
              <p class="text-xs uppercase tracking-[0.18em] text-[var(--portfolio-muted-soft)]">
                Engineering direction
              </p>

              <p class="mt-2 font-serif text-lg text-[var(--portfolio-ink)]">
                Backend · Full-Stack · DevOps
              </p>
            </div>

            <div class="border-b border-[var(--portfolio-line)] py-5">
              <p class="text-xs uppercase tracking-[0.18em] text-[var(--portfolio-muted-soft)]">
                Based
              </p>

              <p class="mt-2 font-serif text-lg text-[var(--portfolio-ink)]">
                United Kingdom
              </p>

              <p class="mt-1 text-sm leading-6 text-[var(--portfolio-muted)]">
                Open to remote, hybrid and international opportunities
              </p>
            </div>
          </div>
        </aside>

        <div class="max-w-4xl space-y-7 text-base leading-8 text-[var(--portfolio-muted)]">
          <p>
            My route into software engineering began through customer
            operations, management and automotive technology. Working with
            high-volume operational systems and ADAS data shaped how I think
            about reliability, process, communication and attention to detail.
          </p>

          <p>
            I now apply that experience to backend and full-stack development.
            My projects are built around practical requirements such as
            authentication, database persistence, validation, responsive
            interfaces, testing, deployment and clear technical documentation.
          </p>

          <p>
            I&apos;m particularly interested in the point where technical
            architecture meets the person using the product. That is reflected
            in projects such as Bloom, where accessibility and calm interaction
            design are treated as core engineering requirements rather than
            finishing touches.
          </p>

          <p>
            Alongside my engineering portfolio, I&apos;m developing Iris &amp;
            Oak, a small digital development business focused on clear,
            responsive websites and useful digital products for organisations
            and small businesses.
          </p>
        </div>
      </div>
    </section>

    <!-- Engineering direction -->
    <section class="border-y border-[var(--portfolio-line)] bg-[var(--portfolio-surface-soft)] px-6 py-20 md:px-10 md:py-24">
      <div class="w-full">
        <div class="mb-12">
          <p class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
            Engineering direction
          </p>

          <h2 class="mt-4 max-w-3xl font-serif text-3xl leading-tight md:text-4xl">
            Building across the complete product path.
          </h2>
        </div>

        <div class="grid border-t border-[var(--portfolio-line)] md:grid-cols-3">
          <article class="border-b border-[var(--portfolio-line)] py-7 md:border-r md:px-7 md:first:pl-0">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-[var(--portfolio-accent)]">
              01 / Backend
            </p>

            <h3 class="mt-5 font-serif text-2xl text-[var(--portfolio-ink)]">
              Reliable foundations
            </h3>

            <p class="mt-4 text-sm leading-7 text-[var(--portfolio-muted)]">
              API design, authentication, database persistence, validation,
              testing and structured application architecture using FastAPI
              and PostgreSQL.
            </p>
          </article>

          <article class="border-b border-[var(--portfolio-line)] py-7 md:border-r md:px-7">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-[var(--portfolio-accent)]">
              02 / Full-Stack
            </p>

            <h3 class="mt-5 font-serif text-2xl text-[var(--portfolio-ink)]">
              Complete user flows
            </h3>

            <p class="mt-4 text-sm leading-7 text-[var(--portfolio-muted)]">
              Connecting React and TypeScript interfaces to real backend
              services, protected routes, persistent data and responsive,
              accessible product experiences.
            </p>
          </article>

          <article class="border-b border-[var(--portfolio-line)] py-7 md:px-7 md:last:pr-0">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-[var(--portfolio-accent)]">
              03 / Delivery
            </p>

            <h3 class="mt-5 font-serif text-2xl text-[var(--portfolio-ink)]">
              Beyond the demo
            </h3>

            <p class="mt-4 text-sm leading-7 text-[var(--portfolio-muted)]">
              Docker environments, GitHub Actions, deployment workflows,
              monitoring, documentation and the debugging needed to keep
              applications working.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Current stack -->
    <section class="bg-[#26372D] px-6 py-20 text-[#F7F6F1] md:px-10 md:py-24">
      <div class="w-full">
        <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.25em] text-[#AEBDAE]">
              Current stack
            </p>

            <h2 class="mt-4 max-w-xl font-serif text-3xl leading-tight md:text-4xl">
              Tools I use to move from idea to deployed system.
            </h2>
          </div>

          <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
            <div class="border-t border-white/20 pt-5">
              <p class="text-xs uppercase tracking-[0.18em] text-[#AEBDAE]">
                Backend
              </p>

              <p class="mt-3 text-sm leading-7 text-[#D8E0D8]">
                Python · FastAPI · PostgreSQL · SQLAlchemy · REST APIs · JWT
              </p>
            </div>

            <div class="border-t border-white/20 pt-5">
              <p class="text-xs uppercase tracking-[0.18em] text-[#AEBDAE]">
                Frontend
              </p>

              <p class="mt-3 text-sm leading-7 text-[#D8E0D8]">
                React · TypeScript · JavaScript · Astro · Tailwind CSS
              </p>
            </div>

            <div class="border-t border-white/20 pt-5">
              <p class="text-xs uppercase tracking-[0.18em] text-[#AEBDAE]">
                Workflow
              </p>

              <p class="mt-3 text-sm leading-7 text-[#D8E0D8]">
                Docker · Git · GitHub Actions · Pytest · Vercel · Render
              </p>
            </div>

            <div class="border-t border-white/20 pt-5">
              <p class="text-xs uppercase tracking-[0.18em] text-[#AEBDAE]">
                Developing
              </p>

              <p class="mt-3 text-sm leading-7 text-[#D8E0D8]">
                Java · Spring Boot · PHP / WordPress · AWS fundamentals · Technical Japanese
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Working principles -->
    <section class="px-6 py-20 md:px-10 md:py-24">
      <div class="grid w-full gap-12 lg:grid-cols-[0.65fr_1.35fr]">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
            Working principles
          </p>

          <h2 class="mt-4 font-serif text-3xl text-[var(--portfolio-ink)] md:text-4xl">
            How I approach the work.
          </h2>
        </div>

        <ol class="border-t border-[#BCC4B9]">
          {
            [
              "Build something useful before making it clever.",
              "Understand the error before reaching for the fix.",
              "Treat accessibility as an engineering requirement.",
              "Write code and documentation for the next person.",
              "Ship focused, working systems and improve them deliberately.",
            ].map((principle, index) => (
              <li class="grid grid-cols-[auto_1fr] gap-5 border-b border-[var(--portfolio-line)] py-5">
                <span class="font-mono text-xs text-[var(--portfolio-muted-soft)]">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <span class="font-serif text-lg text-[var(--portfolio-ink)]">
                  {principle}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-[var(--portfolio-line)] bg-[var(--portfolio-surface-soft)] px-6 py-16 md:px-10">
      <div class="flex w-full flex-col gap-8 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]">
            Explore further
          </p>

          <h2 class="mt-3 font-serif text-2xl text-[var(--portfolio-ink)] md:text-3xl">
            See the systems and thinking behind the work.
          </h2>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href="/work"
            class="inline-flex items-center justify-center gap-2 bg-[#526A57] px-4 py-2.5 text-xs font-medium text-white transition hover:bg-[#405544] whitespace-nowrap"
          >
            View my work
            <span aria-hidden="true">→</span>
          </a>

          <a
            href="/the-build-room"
            class="inline-flex items-center justify-center gap-2 border border-[#9DAA9D] px-4 py-2.5 text-xs font-medium text-[var(--portfolio-accent)] transition hover:border-[#526A57] hover:bg-[#26372D]/50 light:hover:bg-[var(--portfolio-accent)]/20 whitespace-nowrap"
          >
            Enter The Build Room
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>