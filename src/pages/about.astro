---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
---

<MainLayout
  title="About | Ashleigh Magloire"
  description="About Ashleigh Magloire, a backend-focused full-stack developer with a background in automotive technology and operations."
>
  <Navbar client:load />

  <main class="min-h-screen bg-[var(--portfolio-bg)] text-[var(--portfolio-ink)]">
    <section class="px-6 py-12 md:px-10 md:py-16 xl:px-16">
      <div class="grid w-full gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
        <!-- Profile sidebar -->
        <aside
          class="border-b border-[var(--portfolio-line)] pb-8 lg:border-b-0 lg:border-r lg:pb-0 lg:pr-10"
          aria-label="Profile details"
        >
          <div class="flex aspect-square w-full max-w-xs items-center justify-center border border-[var(--portfolio-line)] bg-transparent p-4">
            <img
              src="/images/hero/chibi-illustration.png"
              alt="Illustrated portrait of Ashleigh"
              class="h-full w-full object-contain"
            />
          </div>


          <h2 class="mt-6 text-lg tracking-[0.16em]">
            Ashleigh Magloire
          </h2>

          <p class="mt-2 text-xs uppercase tracking-[0.24em] text-[var(--portfolio-accent)]">
            Backend &amp; Full-Stack Developer
          </p>

          <dl class="mt-7 space-y-5 border-t border-[var(--portfolio-line)] pt-6 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-[0.16em] text-[var(--portfolio-muted-soft)]">
                Based
              </dt>
              <dd class="mt-1 text-[var(--portfolio-ink)]">
                London · Edinburgh
              </dd>
            </div>

            <div>
              <dt class="text-xs uppercase tracking-[0.16em] text-[var(--portfolio-muted-soft)]">
                Education
              </dt>
              <dd class="mt-1 leading-6 text-[var(--portfolio-ink)]">
                MSc Computer Science<br />
                Heriot-Watt University
              </dd>
              <dd class="mt-1 text-xs leading-6 text-[var(--portfolio-ink)]">
                2026 –
              </dd>
            </div>

            <div>
              <dt class="text-xs uppercase tracking-[0.16em] text-[var(--portfolio-muted-soft)]">
                Background
              </dt>
              <dd class="mt-1 leading-6 text-[var(--portfolio-ink)]">
                Automotive Technology &amp; Operations
              </dd>
            </div>
          </dl>

          <a
            href="https://github.com/Iris408"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-7 inline-flex text-sm text-[var(--portfolio-muted)] underline decoration-[var(--portfolio-line)] underline-offset-4 transition hover:text-[var(--portfolio-ink)] hover:decoration-[var(--portfolio-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--portfolio-accent)]"
          >
            GitHub <span class="ml-2" aria-hidden="true">↗</span>
          </a>
        </aside>

        <!-- About content -->
        <div class="min-w-0">
          <section aria-labelledby="about-title">
            <p class="text-xs font-medium uppercase tracking-[0.3em] text-[var(--portfolio-accent)]">
              About
            </p>

            <h1
              id="about-title"
              class="mt-5 max-w-4xl font-serif text-4xl leading-tight md:text-5xl xl:text-6xl"
            >
              Systems thinking.<br />
              People-first engineering.
            </h1>

            <p class="mt-6 max-w-4xl text-base leading-8 text-[var(--portfolio-muted)]">
              I'm a backend-focused full-stack developer with a background in automotive
              technology and operations, where I saw how much depends on systems working
              reliably behind the scenes. I also run
              <a
                href="https://irisoak.dev"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--portfolio-ink)] underline decoration-transparent underline-offset-4 transition-colors hover:decoration-[var(--portfolio-accent)] focus-visible:decoration-[var(--portfolio-accent)]"
              > Iris &amp; Oak</a>, 
              a small studio building websites for independent businesses.
            </p>
          </section>

          <!-- What I bring -->
          <section
            class="mt-10 border-t border-[var(--portfolio-line)] pt-5"
            aria-labelledby="strengths-title"
          >
            <h2
              id="strengths-title"
              class="mb-2 text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]"
            >
              What I bring
            </h2>

            <div class="border-t border-[var(--portfolio-line)]">
              <article class="grid gap-3 border-b border-[var(--portfolio-line)] py-4 sm:grid-cols-[3rem_minmax(10rem,0.8fr)_minmax(0,1.5fr)] sm:items-center sm:gap-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-[var(--portfolio-surface-soft)] font-mono text-xs text-[var(--portfolio-accent)]" aria-hidden="true">
                  01
                </span>
                <h3 class="text-sm font-medium">Operational perspective</h3>
                <p class="text-sm leading-6 text-[var(--portfolio-muted)]">
                    My automotive and operations experience helps me understand the workflows and people behind a software requirement.
                </p>
              </article>

              <article class="grid gap-3 border-b border-[var(--portfolio-line)] py-4 sm:grid-cols-[3rem_minmax(10rem,0.8fr)_minmax(0,1.5fr)] sm:items-center sm:gap-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-[var(--portfolio-surface-soft)] font-mono text-xs text-[var(--portfolio-accent)]" aria-hidden="true">
                  02
                </span>
                <h3 class="text-sm font-medium">End-to-end thinking</h3>
                <p class="text-sm leading-6 text-[var(--portfolio-muted)]">
                  I work across APIs, data models and React interfaces, following how information moves from the backend to the user.
                </p>
              </article>

              <article class="grid gap-3 border-b border-[var(--portfolio-line)] py-4 sm:grid-cols-[3rem_minmax(10rem,0.8fr)_minmax(0,1.5fr)] sm:items-center sm:gap-5">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-[var(--portfolio-surface-soft)] font-mono text-xs text-[var(--portfolio-accent)]" aria-hidden="true">
                  03
                </span>
                <h3 class="text-sm font-medium">Methodical problem-solving</h3>
                <p class="text-sm leading-6 text-[var(--portfolio-muted)]">
                  I trace issues across the frontend, API, database and environment, then verify and document the fix.
                </p>
              </article>
            </div>
          </section>

          <!-- Toolkit -->
          <section
            class="mt-8 border-t border-[var(--portfolio-line)] pt-5"
            aria-labelledby="toolkit-title"
          >
            <h2
              id="toolkit-title"
              class="text-xs font-medium uppercase tracking-[0.25em] text-[var(--portfolio-accent)]"
            >
              Toolkit
            </h2>

            <ul class="mt-5 flex flex-wrap gap-2">
              {
                [
                  "Python",
                  "FastAPI",
                  "PostgreSQL",
                  "SQLAlchemy",
                  "Pytest",
                  "React",
                  "TypeScript",
                  "Docker",
                  "GitHub Actions",
                ].map((skill) => (
                  <li class="rounded-full border border-[var(--portfolio-line)] px-3.5 py-2 text-sm text-[var(--portfolio-ink)]">
                    {skill}
                  </li>
                ))
              }
            </ul>

            <p class="mt-4 text-sm text-[var(--portfolio-muted-soft)]">
              Currently exploring <strong>C#</strong> and <strong>.NET</strong> by migrating 
              <a
                href="https://partspilot.uk"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--portfolio-ink)] underline decoration-transparent underline-offset-4 transition-colors hover:decoration-[var(--portfolio-accent)] focus-visible:decoration-[var(--portfolio-accent)]"
              > PartsPilot</a> to a new backend.
            </p>
          </section>

          <!-- Links -->
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-[var(--portfolio-line)] pt-6">
            <a
              href="/projects"
              class="inline-flex items-center gap-2 bg-[var(--portfolio-accent)] px-5 py-3 text-sm text-[var(--portfolio-bg)] transition hover:opacity-85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--portfolio-accent)]"
            >
              View my projects <span aria-hidden="true">→</span>
            </a>

            <a
              href="/Ashleigh_Magloire_Software_Engineer_Resume.pdf"
              download="Ashleigh_Magloire_Software_Engineer_Resume.pdf"
              class="inline-flex items-center gap-2 bg-[var(--portfolio-ink)] px-5 py-3 text-sm text-[var(--portfolio-bg)] transition hover:opacity-85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--portfolio-accent)]"
            >
              Download CV
              <span aria-hidden="true">↓</span>
            </a>  

            <a
              href="mailto:ashmagloire45@icloud.com"
              class="text-sm text-[var(--portfolio-ink)] underline decoration-[var(--portfolio-line)] underline-offset-4 transition hover:decoration-[var(--portfolio-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--portfolio-accent)]"
            >
              Get in touch <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</MainLayout>