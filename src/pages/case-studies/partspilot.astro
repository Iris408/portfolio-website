---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.jsx";
import Footer from "../../components/Footer.jsx";

const features = [
  {
    number: "01",
    title: "Inventory management",
    description: "Manage products, quantities, categories and stock thresholds.",
  },
  {
    number: "02",
    title: "Stock monitoring",
    description: "Search, filter and sort inventory, including low-stock items.",
  },
  {
    number: "03",
    title: "Operational reporting",
    description: "Review inventory totals and category summaries, with CSV and Power BI reporting.",
  },
];

const architecture = [
  {
    title: "React",
    description: "Responsive interface for inventory workflows and reporting.",
  },
  {
    title: "FastAPI",
    description: "REST API for validation, authentication and inventory operations.",
  },
  {
    title: "PostgreSQL",
    description: "Persistent storage for inventory, stock and supplier data.",
  },
];

const technologies = [
  "React",
  "TypeScript",
  "Vite",
  "Tailwind CSS",
  "FastAPI",
  "PostgreSQL",
  "SQLAlchemy",
  "Docker",
  "Power BI",
];
---

<MainLayout
  title="PartsPilot Case Study | Ashleigh Magloire"
  description="PartsPilot is a full-stack automotive inventory platform with stock-management workflows and operational reporting."
>
  <Navbar client:load />

  <main class="min-h-screen bg-[var(--portfolio-bg)] text-[var(--portfolio-ink)]">
    <div class="px-6 pb-20 pt-24 md:px-10 md:pt-28">
      <section class="grid items-center gap-10 border-b border-[var(--portfolio-line)] pb-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14 lg:pb-16">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.24em] text-[var(--portfolio-accent)]">
            Case Study · Full-Stack · Automotive
          </p>

          <h1 class="mt-5 font-serif text-5xl leading-tight tracking-tight md:text-7xl">
            PartsPilot
          </h1>

          <p class="mt-5 max-w-xl text-base leading-7 text-[var(--portfolio-muted)] md:text-lg">
            An automotive inventory platform connecting stock-management
            workflows with useful operational reporting.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="https://www.partspilot.uk"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[var(--portfolio-accent)] px-5 py-3 text-sm font-medium text-white transition hover:opacity-85"
            >
              View live project <span aria-hidden="true">↗</span>
            </a>

            <a
              href="https://github.com/Iris408/partspilot"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-[var(--portfolio-line)] px-5 py-3 text-sm font-medium transition hover:border-[var(--portfolio-accent)]"
            >
              See source code <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="overflow-hidden border border-[var(--portfolio-line)] bg-[var(--portfolio-surface)]">
          <img
            src="/screenshots/partspilot/partspilot-homepage.png"
            alt="PartsPilot automotive inventory management application"
            class="aspect-[16/10] h-full w-full object-cover object-top"
          />
        </div>
      </section>

      <section class="border-b border-[var(--portfolio-line)] py-8 md:py-10">
        <div class="mb-5 flex items-center gap-5">
          <h2 class="shrink-0 font-serif text-2xl">What it does</h2>
          <div class="h-px flex-1 bg-[var(--portfolio-line)]"></div>
        </div>

        <div class="grid gap-3 md:grid-cols-3">
          {features.map((feature) => (
            <article class="border border-[var(--portfolio-line)] bg-[var(--portfolio-surface)] p-5">
              <p class="text-xs font-semibold tracking-[0.16em] text-[var(--portfolio-accent)]">
                {feature.number}
              </p>
              <h3 class="mt-3 font-serif text-lg">{feature.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[var(--portfolio-muted)]">
                {feature.description}
              </p>
            </article>
          ))}
        </div>
      </section>

      <section class="border-b border-[var(--portfolio-line)] py-8 md:py-10">
        <div class="mb-5 flex items-center gap-5">
          <h2 class="shrink-0 font-serif text-2xl">How it works</h2>
          <div class="h-px flex-1 bg-[var(--portfolio-line)]"></div>
        </div>

        <div class="grid gap-3 md:grid-cols-[1fr_auto_1fr_auto_1fr] md:items-center">
          {architecture.map((layer, index) => (
            <>
              <article class="border border-[var(--portfolio-line)] bg-[var(--portfolio-surface)] p-5">
                <h3 class="font-serif text-lg">{layer.title}</h3>
                <p class="mt-2 text-sm leading-6 text-[var(--portfolio-muted)]">
                  {layer.description}
                </p>
              </article>
              {index < architecture.length - 1 && (
                <span class="hidden text-lg text-[var(--portfolio-accent)] md:block" aria-hidden="true">
                  →
                </span>
              )}
            </>
          ))}
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          {technologies.map((technology) => (
            <span class="rounded-full bg-[var(--portfolio-surface-soft)] px-3 py-1.5 text-xs font-medium text-[var(--portfolio-accent)]">
              {technology}
            </span>
          ))}
        </div>
      </section>

      <section class="border-b border-[var(--portfolio-line)] py-8 md:py-10">
        <div class="grid gap-4 border border-[var(--portfolio-line)] bg-[var(--portfolio-surface-soft)] p-5 md:grid-cols-[10rem_1fr] md:items-center md:p-6">
          <h2 class="font-serif text-xl">Engineering decision</h2>
          <p class="text-sm leading-7 text-[var(--portfolio-muted)]">
            The inventory list is paginated, but dashboard totals need to
            represent every database record. I added separate reporting
            endpoints so the dashboard wouldn’t calculate totals from only the
            visible page of results.
          </p>
        </div>
      </section>

      <a
        href="/the-build-room/current-builds/partspilot"
        class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-[var(--portfolio-accent)] underline underline-offset-4 transition hover:text-[var(--portfolio-ink)]"
      >
        Explore PartsPilot build updates <span aria-hidden="true">→</span>
      </a>
    </div>
  </main>

  <Footer />
</MainLayout>