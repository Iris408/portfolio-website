---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.jsx";
import Hero from "../components/Hero.jsx";
import Work from "../components/Work.jsx";
import CurrentStack from "../components/CurrentStack.jsx";
import TheBuildRoom from "../components/TheBuildRoom.jsx";
import Contact from "../components/Contact.jsx";
import Footer from "../components/Footer.jsx";
---

<MainLayout>
  <a
    href="#main-content"
    class="fixed left-4 top-4 z-[100] -translate-y-24 bg-[#26372D] px-4 py-3 text-sm font-medium text-white transition focus:translate-y-0"
  >
    Skip to main content
  </a>
  <Navbar client:load />

  <main id="main-content">
    <Hero />
    <Work client:load />
    <CurrentStack />
    <TheBuildRoom />
    <Contact />
  </main>

  <Footer />
</MainLayout>