---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
import BuildRoomTabs from "../components/BuildRoomTabs.jsx";
---

<MainLayout
  title="The Build Room | Ashleigh Magloire"
  description="Current builds and engineering notes from Ashleigh Magloire."
>
  <Navbar client:load />

  <main class="min-h-screen bg-[var(--portfolio-bg)] text-[var(--portfolio-ink)]">
    <section class="border-b border-[var(--portfolio-line)] px-6 pb-20 pt-12 md:px-10 md:pb-20 md:pt-14">
      <div class="grid w-full gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="mb-5 text-xs font-medium uppercase tracking-[0.3em] text-[var(--portfolio-accent)]">
            The Build Room
          </p>

          <h1 class="max-w-4xl font-serif text-4xl leading-tight text-[var(--portfolio-ink)] md:text-6xl">
            Current builds, prototypes, experiments and the notes behind them.
          </h1>
        </div>

        <div class="border-l border-[var(--portfolio-line)] pl-6 md:pl-8">
          <p class="text-base leading-8 text-[var(--portfolio-muted)]">
            A place to follow what I’m building, the problems I encounter, and
          what I learn along the way.
          </p>
        </div>
      </div>
    </section>

    <section class="px-6 pb-16 md:px-10 md:pb-20">
      <BuildRoomTabs client:load />

      <a
        href="https://iris408.github.io/technical-blog/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-[var(--portfolio-accent)] underline underline-offset-4 transition hover:text-[var(--portfolio-ink)]"
      >
        Visit the Japanese Technical Notebook
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <Footer />
</MainLayout>